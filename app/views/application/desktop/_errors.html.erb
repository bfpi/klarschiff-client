<div class="errors">
  <% if @errors.present? -%>
    <div class="row">
      <div class="col-12">
        <div class="alert alert-danger" role="alert">
          <strong><%= t("#{controller_name}.desktop.create.error") %></strong>
          <ul>
            <% messages = @errors.try(:full_messages) || @errors.pluck(:base).flatten -%>
            <% messages.each do |msg| -%>
              <li><%= msg %></li>
            <% end -%>
          </ul>
        </div>
      </div>
    </div>
  <% end -%>
</div>
